# Oracle Cloud watch-proxy deployment for medic.cymru.
# This host serves the isolated player and proxies HLS. No FFmpeg is installed.

server {
    listen 80;
    server_name medic.cymru www.medic.cymru;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name medic.cymru www.medic.cymru;

    ssl_certificate /etc/letsencrypt/live/medic.cymru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/medic.cymru/privkey.pem;

    root /var/www/koratv-player;
    access_log off;

    add_header Content-Security-Policy "default-src 'none'; script-src 'self' https: 'unsafe-inline'; style-src 'self'; img-src 'self' https: data:; media-src blob:; connect-src https:; worker-src blob:; frame-src https:; frame-ancestors https: http:; base-uri 'none'; form-action 'none'" always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Content-Type-Options nosniff always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;

    location = / {
        try_files /739184.html =404;
    }

    location = /player.html {
        return 404;
    }

    location = /healthz {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP "";
    }

    location ~* \.(?:m3u8)$ {
        add_header Cache-Control "no-store, must-revalidate" always;
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 45s;
        proxy_send_timeout 45s;
    }

    location ~ ^/[A-Za-z0-9]{10,24}$ {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP "";
    }

    location / {
        add_header Cache-Control "public, max-age=300" always;
        try_files $uri =404;
    }
}
