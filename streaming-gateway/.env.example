PORT=3100
HOST=127.0.0.1
PUBLIC_API_ORIGIN=https://stream-api.koratv.click
FRONTEND_ORIGIN=https://koratv.click
PLAYER_ORIGIN=https://medic.cymru
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-bytes
HMAC_SECRET=replace-with-a-different-random-secret
REDIS_URL=redis://127.0.0.1:6379
# Only the actual reverse proxy addresses/CIDRs. Never use true or a hop count.
TRUSTED_PROXIES=loopback
# Set only after the proxy strips forged CF headers and only accepts Cloudflare traffic.
CLOUDFLARE_HEADER_TRUSTED_PROXIES=
NEXT_PUBLIC_SUPABASE_URL=https://vzgldruuinbwslrfwjkb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional server-only key. Public-key reads work with the supplied RLS migration.
SUPABASE_SECRET_KEY=
# Server-owned allowlist. Never accept an upstream URL from a browser.
STREAMS_JSON={"demo":"https://media.example.com/live/master.m3u8"}
UPSTREAM_ORIGINS=https://media.example.com
