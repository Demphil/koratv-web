# Temporary production Nginx configuration used while fabor.sbs DNS/SSL is still propagating.
# The API stays on its existing HTTPS certificate. The player domain is exposed on HTTP only
# until certbot can issue /etc/letsencrypt/live/fabor.sbs.

server {
    listen 80;
    server_name stream-api.koratv.click;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name stream-api.koratv.click;

    ssl_certificate /etc/letsencrypt/live/stream-api.koratv.click/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stream-api.koratv.click/privkey.pem;
    access_log off;

    location = /healthz {
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP "";
    }

    location /api/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP "";
        proxy_buffering off;
        proxy_read_timeout 30s;
    }

    location / {
        return 404;
    }
}

server {
    listen 80;
    server_name fabor.sbs www.fabor.sbs;
    root /var/www/koratv-player;
    access_log off;

    add_header Content-Security-Policy "default-src 'none'; script-src 'self' https: 'unsafe-inline'; style-src 'self'; img-src 'self' https: data:; media-src blob:; connect-src https:; worker-src blob:; frame-src https:; frame-ancestors 'self' https://frajatv.fun https://www.frajatv.fun https://fraja.online https://koratv.click https://www.koratv.click; base-uri 'none'; form-action 'none'" always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control no-store always;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location = / {
        return 403;
    }

    location = /player.html {
        return 404;
    }

    location = /739184.html {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header CF-Connecting-IP "";
    }

    location = /watch.html {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header CF-Connecting-IP "";
    }

    location ~ "^/[A-Za-z0-9]{10,24}$" {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header CF-Connecting-IP "";
    }

    location / {
        try_files $uri =404;
    }
}
