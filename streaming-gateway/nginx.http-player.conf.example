# Temporary production Nginx configuration used while fabor.sbs DNS/SSL is still propagating.
# The API stays on its existing HTTPS certificate. The player domain is exposed on HTTP only
# until certbot can issue /etc/letsencrypt/live/fabor.sbs.

map $uri $koratv_cache_control {
    default "no-store";
    ~*\.(js|css|svg|png|ico|woff2?)$ "public, max-age=3600";
}

upstream koratv_gateway {
    server 51.170.48.95:443;
    keepalive 64;
    keepalive_requests 1000;
    keepalive_timeout 60s;
}

server {
    listen 80;
    server_name stream-api.koratv.click;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name stream-api.koratv.click;

    keepalive_timeout 15s;
    keepalive_requests 20;
    keepalive_time 1m;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types application/json application/javascript text/css;

    proxy_ssl_server_name on;
    proxy_ssl_name oracle-gateway.internal;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 2;
    proxy_ssl_trusted_certificate /etc/koratv/oracle-link/ca.crt;
    proxy_ssl_certificate /etc/koratv/oracle-link/client.crt;
    proxy_ssl_certificate_key /etc/koratv/oracle-link/client.key;
    proxy_connect_timeout 8s;

    ssl_certificate /etc/letsencrypt/live/stream-api.koratv.click/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stream-api.koratv.click/privkey.pem;
    access_log off;

    location = /healthz {
        proxy_pass https://koratv_gateway;
        proxy_set_header Host oracle-gateway.internal;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP "";
    }

    location /api/ {
        proxy_pass https://koratv_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host oracle-gateway.internal;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_socket_keepalive on;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    location / {
        return 404;
    }
}

server {
    listen 80;
    server_name fabor.sbs www.fabor.sbs;
    proxy_ssl_server_name on;
    proxy_ssl_name oracle-gateway.internal;
    proxy_ssl_verify on;
    proxy_ssl_verify_depth 2;
    proxy_ssl_trusted_certificate /etc/koratv/oracle-link/ca.crt;
    proxy_ssl_certificate /etc/koratv/oracle-link/client.crt;
    proxy_ssl_certificate_key /etc/koratv/oracle-link/client.key;
    proxy_connect_timeout 8s;
    root /var/www/koratv-player;
    access_log off;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types application/javascript text/css application/json image/svg+xml;

# Public embeds include file:// parents; do not add frame-ancestors or X-Frame-Options here.
add_header Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline' https://nap5k.com https://n6wxm.com https://al5sm.com; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src 'self' blob: https://stream-api.koratv.click; connect-src 'self' https:; worker-src blob:; frame-src 'self' https:; base-uri 'none'; form-action 'none'" always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control $koratv_cache_control always;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        try_files $uri =404;
    }

    location = / {
        return 403;
    }

    location = /player.html {
        return 404;
    }

    location = /739184.html {
        proxy_pass https://koratv_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host oracle-gateway.internal;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header CF-Connecting-IP "";
    }

    location = /watch.html {
        proxy_pass https://koratv_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host oracle-gateway.internal;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header CF-Connecting-IP "";
    }

    location /api/ {
        proxy_pass https://koratv_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host oracle-gateway.internal;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header CF-Connecting-IP "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_socket_keepalive on;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    location ~ "^/[A-Za-z0-9]{10,24}$" {
        proxy_pass https://koratv_gateway;
        proxy_http_version 1.1;
        proxy_set_header Host oracle-gateway.internal;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header CF-Connecting-IP "";
    }

    location / {
        try_files $uri =404;
    }
    location ~ /\.(?!well-known/) {
        return 404;
    }
    location ~* \.(map|md|env|log|sql|php|ya?ml|toml|bak|backup)$ {
        return 404;
    }
}
