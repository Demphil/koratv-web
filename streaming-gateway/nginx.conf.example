# Install valid TLS certificates before enabling these server blocks.
# This example assumes Nginx directly receives the public client connection.
server {
    listen 443 ssl;
    server_name stream-api.koratv.click;
    ssl_certificate /etc/letsencrypt/live/stream-api.koratv.click/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stream-api.koratv.click/privkey.pem;
    # Query strings contain short-lived credentials.
    access_log off;
    location /api/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        # Direct-facing example: do not forward a user-supplied Cloudflare IP.
        proxy_set_header CF-Connecting-IP "";
        proxy_buffering off;
        proxy_read_timeout 30s;
    }
    location / { return 404; }
}

server {
    listen 443 ssl;
    server_name medic.cymru;
    ssl_certificate /etc/letsencrypt/live/medic.cymru/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/medic.cymru/privkey.pem;
    root /var/www/koratv-player;
    access_log off;
    add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; media-src blob:; connect-src https://stream-api.koratv.click; worker-src blob:; frame-ancestors https://koratv.click; base-uri 'none'; form-action 'none'" always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control no-store always;
    location / { try_files $uri =404; }
}
