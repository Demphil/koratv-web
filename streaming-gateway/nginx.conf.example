# Production Nginx configuration for the gateway and isolated player.
# TLS certificates must exist before this file is enabled.

upstream koratv_gateway {
    server 127.0.0.1:3100;
    keepalive 64;
    keepalive_requests 1000;
    keepalive_timeout 60s;
}

server {
    listen 80;
    server_name stream-api.koratv.click fabor.sbs www.fabor.sbs;
    return 301 https://$host$request_uri;
}

# Preserve the existing frontend route while its VPS migration is completed.
server {
    listen 80;
    server_name koratv.click www.koratv.click;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header CF-Connecting-IP "";
    }
}

server {
    listen 443 ssl http2;
    server_name stream-api.koratv.click;

    ssl_certificate /etc/letsencrypt/live/stream-api.koratv.click/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stream-api.koratv.click/privkey.pem;
    access_log off;

    location = /healthz {
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP "";
    }

    location /api/ {
        proxy_pass http://koratv_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        # Nginx receives the client directly, so never trust a supplied Cloudflare header.
        proxy_set_header CF-Connecting-IP "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_socket_keepalive on;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    location / {
        return 404;
    }
}

server {
    listen 443 ssl http2;
    server_name fabor.sbs www.fabor.sbs;

    ssl_certificate /etc/letsencrypt/live/fabor.sbs/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fabor.sbs/privkey.pem;
    root /var/www/koratv-player;
    access_log off;

# Public embeds include file:// parents; do not add frame-ancestors or X-Frame-Options here.
add_header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' https: data:; media-src 'self' blob:; connect-src 'self' https:; worker-src blob:; frame-src 'self'; base-uri 'none'; form-action 'none'" always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control no-store always;

    location = / {
        return 403;
    }

    location = /player.html {
        return 404;
    }

    # Untrusted ads cannot navigate, access storage, open tabs, or escape this frame.
    location = /ad-frame.html {
        add_header Content-Security-Policy "sandbox allow-scripts; default-src 'none'; script-src 'self' https: 'unsafe-inline'; style-src 'self' https: 'unsafe-inline'; img-src 'self' https: data:; connect-src https:; frame-src https:; base-uri 'none'; form-action 'none'" always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Content-Type-Options nosniff always;
        add_header Cache-Control no-store always;
        try_files $uri =404;
    }

    location = /739184.html {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP "";
    }

    location = /watch.html {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP "";
    }

    location /api/ {
        proxy_pass http://koratv_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_socket_keepalive on;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    location ~ "^/[A-Za-z0-9]{10,24}$" {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP "";
    }

    location / {
        try_files $uri =404;
    }
}
