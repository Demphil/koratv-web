# Production Nginx configuration for the gateway and isolated player.
# TLS certificates must exist before this file is enabled.

map $uri $koratv_cache_control {
    default "no-store";
    ~*\.(js|css|svg|png|ico|woff2?)$ "public, max-age=3600";
}

upstream koratv_gateway {
    # Njalla loopback is an SSH forward to the single Oracle gateway process.
    server 127.0.0.1:3100;
    keepalive 64;
    keepalive_requests 1000;
    keepalive_timeout 60s;
}

server {
    listen 80;
    server_name stream-api.koratv.click fabor.sbs www.fabor.sbs;
    return 301 https://$host$request_uri;
}

# Preserve the existing frontend route while its VPS migration is completed.
server {
    listen 80;
    server_name koratv.click www.koratv.click;

    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header CF-Connecting-IP "";
    }
}

server {
    listen 443 ssl http2;
    server_name stream-api.koratv.click;

    ssl_certificate /etc/letsencrypt/live/stream-api.koratv.click/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stream-api.koratv.click/privkey.pem;
    access_log off;

    location = /healthz {
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP "";
    }

    location /api/ {
        proxy_pass http://koratv_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        # Nginx receives the client directly, so never trust a supplied Cloudflare header.
        proxy_set_header CF-Connecting-IP "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_socket_keepalive on;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    location / {
        return 404;
    }
}

server {
    listen 443 ssl http2;
    server_name fabor.sbs www.fabor.sbs;

    ssl_certificate /etc/letsencrypt/live/fabor.sbs/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fabor.sbs/privkey.pem;
    root /var/www/koratv-player;
    access_log off;
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types application/javascript text/css application/json image/svg+xml;

# Public embeds include file:// parents; do not add frame-ancestors or X-Frame-Options here.
add_header Content-Security-Policy "default-src 'none'; script-src 'self' 'unsafe-inline' https://nap5k.com https://n6wxm.com https://al5sm.com; style-src 'self' 'unsafe-inline'; img-src 'self' https: data:; media-src 'self' blob: https://stream-api.koratv.click; connect-src 'self' https:; worker-src blob:; frame-src 'self' https:; base-uri 'none'; form-action 'none'" always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header X-Content-Type-Options nosniff always;
    add_header Cache-Control $koratv_cache_control always;

    location = / {
        return 403;
    }

    location = /player.html {
        return 404;
    }

    location = /739184.html {
        try_files /739184.html =404;
    }

    location = /watch.html {
        try_files /watch.html =404;
    }

    location /api/ {
        proxy_pass http://koratv_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header Origin $http_origin;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header CF-Connecting-IP "";
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_socket_keepalive on;
        proxy_read_timeout 90s;
        proxy_send_timeout 90s;
    }

    location ~ "^/[A-Za-z0-9]{10,24}$" {
        try_files /739184.html =404;
    }

    location ~ /\.(?!well-known/) {
        return 404;
    }

    location ~* \.(map|md|env|log|sql|php|ya?ml|toml|bak|backup)$ {
        return 404;
    }

    location / {
        try_files $uri =404;
    }
}
