PORT=3100
HOST=127.0.0.1

# Oracle Cloud watch proxy profile. Use the same JWT/HMAC secrets as the
# match API gateway that creates entry tickets, otherwise redeem-token fails.
PUBLIC_API_ORIGIN=https://medic.cymru
FRONTEND_ORIGIN=https://koratv.click
FRONTEND_ORIGINS=https://koratv.click,https://fraja.online
PLAYER_ORIGIN=https://medic.cymru

ENABLE_ANTI_BOT=true
JWT_SECRET=use-the-same-secret-as-the-token-generating-gateway
HMAC_SECRET=use-the-same-hmac-secret-as-the-token-generating-gateway
REDIS_URL=redis://127.0.0.1:6379

# Direct Nginx on the same VM should be the only trusted proxy.
TRUSTED_PROXIES=loopback
CLOUDFLARE_HEADER_TRUSTED_PROXIES=

NEXT_PUBLIC_SUPABASE_URL=https://vzgldruuinbwslrfwjkb.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_MATCHES_TABLE=matches

STREAM_OPENS_BEFORE_MINUTES=20
STREAM_CLOSES_AFTER_MINUTES=150
STREAM_SESSION_TTL_SECONDS=10800

# Add the exact IPTV playlist, segment, and key origins used by the provider.
# Do not add broad unrelated hosts.
UPSTREAM_ORIGINS=https://provider-playlist.example,https://provider-segments.example
IPTV_UPSTREAM_USER_AGENT=VLC/3.0.20 LibVLC/3.0.20
